rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{code} {
      // A long random code is used so guessing an invitation is difficult.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId'])
        && member(request.resource.data.roomId)
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.inviteCode == code;
      allow update, delete: if false;
    }
    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name','ownerUid','members','inviteCode','completed'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.completed == [];
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed'])
          && request.resource.data.completed is list)
        ||
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','joinCode'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.joinCode == resource.data.inviteCode
          && exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode)))
      );
      allow delete: if false;
      match /{kind}/{entryId} {
        allow read: if kind in ['notes','tasks','expenses','events'] && member(roomId);
        allow create: if kind in ['notes','tasks','expenses','events'] && member(roomId)
          && request.resource.data.keys().hasOnly(['text','amount','createdAt','date','done'])
          && (kind != 'events' || (request.resource.data.date is string && request.resource.data.date.size() == 10))
          && (kind != 'tasks' || !('done' in request.resource.data) || request.resource.data.done is bool)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (kind == 'events' || (request.resource.data.amount is int && request.resource.data.amount >= 0));
        allow delete: if kind in ['notes','tasks','expenses','events'] && member(roomId);
        allow update: if kind in ['notes','tasks','expenses','events'] && member(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','amount','date','done'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (kind == 'events' || (request.resource.data.amount is int && request.resource.data.amount >= 0))
          && (kind != 'events' || (request.resource.data.date is string && request.resource.data.date.size() == 10))
          && (kind != 'tasks' || !('done' in request.resource.data) || request.resource.data.done is bool);
      }
    }
  }
}
